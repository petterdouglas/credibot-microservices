# CrediBot: variaveis de ambiente (copie para .env antes de subir: cp .env.example .env)

# API Gateway
GATEWAY_PORT=8080

# Frontedns
WEB_APP_PORT=3000
ADMIN_PANEL_PORT=3100

# PostgreSQL (Loan Service)
POSTGRES_DB=credibot_loan
POSTGRES_USER=credibot_loan_user
POSTGRES_PASSWORD=credibot_loan_pass

# MySQL (Customer Service)
MYSQL_DATABASE=credibot_customer
MYSQL_USER=credibot_customer_user
MYSQL_PASSWORD=credibot_customer_pass
MYSQL_ROOT_PASSWORD=credibot_mysql_root

# MongoDB (Credit Analysis Service)
MONGO_DB=credibot_credit
MONGO_INITDB_ROOT_USERNAME=credibot_mongo_user
MONGO_INITDB_ROOT_PASSWORD=credibot_mongo_pass

# RabbitMQ (Message Broker - SAGA & CQRS)
RABBITMQ_USER=credibot_mq
RABBITMQ_PASSWORD=credibot_mq_pass
RABBITMQ_VHOST=/

# AI Assistant Service (LLM / RAG)
LLM_API_KEY=changeme-your-llm-api-key
LLM_PROVIDER=gemini

# Auth — JWT
# Chave compartilhada entre auth-service e os BFFs para assinar/verificar tokens.
# Mínimo recomendado: 32 caracteres aleatórios. Sem este valor os BFFs entram
# em modo de compatibilidade (sem verificação de assinatura). NÃO omita em produção.
JWT_SECRET=troque-por-uma-chave-secreta-forte

# Auth — Admin BFF
# Credenciais fixas do painel administrativo (sem tabela de analistas no banco).
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-senha-forte
